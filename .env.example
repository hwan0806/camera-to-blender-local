# Copy this file to .env and fill in your keys.

# Tripo3D API — required, generates the 3D models.
# Get your key at https://platform.tripo3d.ai/
TRIPO_API_KEY=your_tripo_api_key_here

# Google Gemini API — optional, used for background removal.
# Get your key at https://aistudio.google.com/
# If left empty, background removal is skipped and the original photo is used.
GEMINI_API_KEY=your_gemini_api_key_here

# Local server port (default: 8001). The server always binds to 127.0.0.1.
PORT=8001
